{
  "name": "docs-editor",
  "private": true,
  "version": "1.0.0",
  "author": "asaf",
  "main": "main.mjs",
  "license": "MIT",
  "description": "doc editor",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:dist": "npm run build && electron-builder --publish=never",
    "cypress:open": "cypress open"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.0",
    "@ckeditor/ckeditor5-react": "^8.0.0",
    "antd": "^5.14.0",
    "ckeditor5": "^41.1.0",
    "diff": "^5.2.0",
    "html-react-parser": "^5.1.8",
    "htmldiff-js": "^1.0.5",
    "match-sorter": "^6.3.4",
    "mobx": "^6.12.0",
    "mobx-react": "^9.1.0",
    "node-fetch": "^3.3.2",
    "parse5": "^7.1.2",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "simple-git": "^3.28.0",
    "sort-by": "^1.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "cypress": "^13.7.1",
    "electron": "^36.2.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "eslint-plugin-cypress": "^2.15.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "vite": "^5.1.0",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.docs-editor.app",
    "productName": "Docs Editor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "dist/**/*",
      "data/**/*"
    ],
    "asarUnpack": [
      "data/**/*"
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker",
      "compression": "maximum"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
